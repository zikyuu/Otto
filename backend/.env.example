# Runs WITHOUT these (fallback parsing + deterministic engine). Add tomorrow.
OPENAI_API_KEY=

# Google Calendar sync (optional, read-only). Create an OAuth client (Web) in Google Cloud and add the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/gcal/callback

# ---- hosting + accounts (Supabase: free tier gives storage and Google sign-in) ----
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=...                  # public key, shipped to the page
# SUPABASE_SERVICE_ROLE_KEY=...          # SECRET: server only, never in the page
# OTTO_REQUIRE_LOGIN=1                   # turn on to require Google sign-in; leave off for local development
# OTTO_ORIGIN=https://<your app>         # with login on, only this origin may call the API from a browser
